# Scraping on-demand (nessun cron obbligatorio)
SCRAPE_USE_PLAYWRIGHT=true        # true in locale — bypass Cloudflare
SCRAPE_ON_DEMAND=true             # scrape aprendo la dashboard / Aggiorna prezzi
SCRAPE_CACHE_TTL=3600             # età max snapshot prima di riscrape automatico
SCRAPE_MIN_INTERVAL=300           # min secondi tra due scrape (evita doppi run)
SCRAPE_USE_SNAPSHOT=true          # mostra subito l'ultimo snapshot, poi aggiorna
# SCRAPE_REFRESH_ON_OPEN=true     # opzionale: riscrape sempre all'apertura
# SCRAPE_SNAPSHOT_PATH=data/scrape-snapshot.json

# CardTrader — solo immagini prodotti/carte (mai prezzi)
# CARDTRADER_API_TOKEN=

# Portfolio manuale (prezzo acquisto, teca plexiglass)
# PORTFOLIO_PATH=data/portfolio.json
