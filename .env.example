# Scraping (nessun abbonamento API)
SCRAPE_USE_PLAYWRIGHT=false   # true in locale per bypass Cloudflare Cardmarket/eBay
SCRAPE_CACHE_TTL=3600         # secondi cache prezzi / età max snapshot
SCRAPE_USE_SNAPSHOT=true        # dashboard legge data/scrape-snapshot.json se fresco
# SCRAPE_SNAPSHOT_PATH=data/scrape-snapshot.json

# CardTrader — solo immagini prodotti/carte (mai prezzi)
# CARDTRADER_API_TOKEN=

# Portfolio manuale (prezzo acquisto, teca plexiglass)
# PORTFOLIO_PATH=data/portfolio.json
